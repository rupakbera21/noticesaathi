# NoticeSaathi — environment variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file containing real values.
# Never quote values in Vercel's dashboard; paste them bare.

# AI providers
GEMINI_API_KEY=
GROQ_API_KEY=

# Knowledge base ingestion
OLOSTEP_API_KEY=

# Upstash Redis (rate limiting and circuit-breaker state)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional model overrides — leave blank to use the verified defaults
GEMINI_MODEL=
GROQ_MODEL=
